# Leave DATABASE_URL empty for local development: the app then runs an embedded
# Postgres (PGlite) out of .pgdata/, so you need nothing installed.
# In production set this to your Neon / Supabase / Vercel Postgres string.
DATABASE_URL=

# No signing secret is needed: session tokens are 256 bits of randomness stored
# (hashed) in the database, so revoking one is a DELETE, not a key rotation.

# Used for canonical URLs, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://revenueexpress.com

# Set to 1 only when a reverse proxy you control (nginx, HAProxy) sits in front
# and rewrites X-Forwarded-For. On Vercel or Cloudflare leave it unset: their
# edge headers are used instead, and honouring X-Forwarded-For without a proxy
# would let any caller pick its own rate-limit bucket.
TRUST_PROXY=
